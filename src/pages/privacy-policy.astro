---
import Base from "../layouts/Base.astro";

const notCollected = [
  "Analytics or usage tracking",
  "Crash reporting",
  "Advertising SDKs",
  "User accounts or login",
  "Internet connection",
  "Data collection of any kind",
];

const h2 = "mb-3 text-lg font-bold text-[#e6edf3]";
const p = "text-sm leading-[1.7] text-[#7d8590]";
---

<Base
  title="Privacy Policy - Neev Grover"
  description="Privacy policy for Neev Grover's Dice Flipper app"
  class="bg-[#080b12]"
>
  <section class="px-6 pt-16 pb-12 text-center">
    <h1 class="text-[32px] font-extrabold tracking-[-0.03em] text-[#e6edf3]">Privacy Policy</h1>
  </section>

  <section class="mx-auto max-w-[720px] px-6 pb-24">
    <div class="rounded-lg border border-[#1c2333] bg-[#0d1117] p-8">
      <p class="mb-8 text-[13px] font-semibold tracking-[0.08em] text-[#7d8590] uppercase">Dice Flipper</p>

      <h2 class={h2}>Overview</h2>
      <p class:list={[p, "mb-4"]}>
        Dice Flipper does not collect, store, transmit, or share any personal data. The app operates
        entirely on your device with no internet connection required.
      </p>

      <h2 class:list={[h2, "mt-10"]}>What We Don't Collect</h2>
      <p class:list={[p, "mb-4"]}>Dice Flipper has absolutely none of the following:</p>
      <ul class="mb-6 grid gap-2">
        {
          notCollected.map((item) => (
            <li class="flex items-center gap-2.5 text-sm leading-[1.7] text-[#7d8590]">
              <span class="size-1 shrink-0 rounded-full bg-[#30363d]" />
              {item}
            </li>
          ))
        }
      </ul>

      <h2 class:list={[h2, "mt-10"]}>Our Commitment</h2>
      <p class:list={[p, "mb-4"]}>
        Nothing you do in the app is sent anywhere. No data is collected, shared, or sold.{" "}
        <strong class="text-[#e6edf3]">Ever.</strong>
      </p>

      <h2 class:list={[h2, "mt-10"]}>Contact</h2>
      <p class={p}>
        If you have any questions about this privacy policy, feel free to reach out at: groverneev at
        gmail dot com
      </p>
    </div>
  </section>
</Base>

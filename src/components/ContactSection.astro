---
import { Icon } from "astro-icon/components";
import { FORMSPREE_URL, social } from "../data";

const label = "mb-1.5 block text-[15px] font-medium";
const input =
  "w-full rounded-lg border border-border bg-surface px-3.5 py-3 text-[15px] text-fg outline-none placeholder:text-dim focus:border-accent";
// Form and success card share one grid cell so the section keeps its height when they swap.
const panel = "[grid-area:1/1] transition-[opacity,visibility] duration-300";
---

<section id="contact" class="scroll-mt-20 px-8">
  <div class="mx-auto max-w-[560px]">
    <p class="section-label mb-4">Contact</p>
    <p class="mb-8 text-[17px] leading-[1.6] text-muted">
      Have a question or want to chat? Drop me a line.
    </p>

    <div id="contact-panels" class="group grid">
      <form
        id="contact-form"
        action={FORMSPREE_URL}
        method="POST"
        class:list={[panel, "flex flex-col gap-3 group-data-sent:invisible group-data-sent:opacity-0"]}
      >
        <div>
          <label for="name" class={label}>Name</label>
          <input id="name" type="text" name="name" required placeholder="Your name" class={input} />
        </div>
        <div>
          <label for="email" class={label}>Email</label>
          <input id="email" type="email" name="email" required placeholder="Your email" class={input} />
        </div>
        <div>
          <label for="message" class={label}>Message</label>
          <textarea id="message" name="message" required rows="4" placeholder="Your message..." class:list={[input, "resize-y"]}></textarea>
        </div>

        <div id="contact-error" hidden role="alert" class="rounded-md border border-[#f5c4b5] bg-[#fff5f2] px-3.5 py-2.5 text-sm text-accent-hover">
          Something went wrong. Please try again or email me directly.
        </div>

        <button
          type="submit"
          class="group/submit flex w-full cursor-pointer items-center justify-center gap-2 rounded-lg bg-accent px-4 py-[13px] text-[15px] font-semibold text-white transition-colors hover:bg-accent-hover disabled:cursor-not-allowed disabled:opacity-75"
        >
          <svg class="hidden size-3.5 animate-spin group-disabled/submit:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
            <path d="M21 12a9 9 0 1 1-6.219-8.56"></path>
          </svg>
          <span class="group-disabled/submit:hidden">Send Message</span>
          <span class="hidden group-disabled/submit:inline">Sending...</span>
        </button>
      </form>

      <div
        id="contact-success"
        aria-live="polite"
        class:list={[
          panel,
          "invisible flex flex-col overflow-hidden rounded-[14px] border border-border bg-surface opacity-0 shadow-card group-data-sent:visible group-data-sent:opacity-100",
        ]}
      >
        <div class="flex flex-1 flex-col items-center justify-center px-8 pt-10 pb-8 text-center">
          <div class="badge mb-6 flex size-16 items-center justify-center rounded-full bg-accent/10 ring-8 ring-accent/5">
            <svg class="size-7 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path class="check" pathLength="1" d="M5 12.5l4.5 4.5L19 7.5"></path>
            </svg>
          </div>
          <h3 id="contact-success-title" tabindex="-1" class="rise mb-2 text-[26px] font-bold tracking-[-0.03em] outline-none">
            Thanks!
          </h3>
          <p class="rise mb-7 max-w-[360px] text-[15px] leading-[1.65] text-muted">
            Your message landed in my inbox. I'll reply to{" "}
            <span id="contact-success-email" class="font-medium break-words text-fg"></span> soon.
          </p>

          <figure class="rise w-full max-w-[400px] rounded-[10px] border border-border bg-bg px-4 py-3.5 text-left">
            <figcaption class="mb-1.5 text-[11px] font-semibold tracking-[0.08em] text-dim uppercase">
              You wrote
            </figcaption>
            <blockquote id="contact-success-message" class="line-clamp-3 text-[14px] leading-[1.6] whitespace-pre-line text-muted"></blockquote>
          </figure>
        </div>

        <div class="flex flex-wrap items-center justify-between gap-3 border-t border-border bg-footer/50 px-6 py-4">
          <button
            id="contact-reset"
            type="button"
            class="inline-flex cursor-pointer items-center gap-1.5 text-sm font-medium text-muted transition-colors hover:text-accent"
          >
            <svg class="size-[13px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M19 12H5"></path>
              <path d="m12 19-7-7 7-7"></path>
            </svg>
            Send another
          </button>
          <div class="flex items-center gap-3.5">
            <span class="text-[13px] text-dim">Meanwhile, find me on</span>
            {
              social.map((link) => (
                <a
                  href={link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={link.label}
                  class="flex text-dim transition-colors hover:text-fg"
                >
                  <Icon name={link.icon} size={15} />
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .check {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }

  [data-sent] .badge {
    animation: pop 0.45s cubic-bezier(0.34, 1.56, 0.64, 1) both;
  }

  [data-sent] .check {
    animation: draw 0.4s 0.25s ease-out forwards;
  }

  /* Text and message preview fade up in sequence after the badge */
  [data-sent] .rise {
    animation: rise 0.45s ease-out both;
  }
  [data-sent] h3.rise {
    animation-delay: 0.15s;
  }
  [data-sent] p.rise {
    animation-delay: 0.22s;
  }
  [data-sent] figure.rise {
    animation-delay: 0.32s;
  }

  @keyframes pop {
    from {
      transform: scale(0.6);
      opacity: 0;
    }
  }

  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes rise {
    from {
      transform: translateY(8px);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-sent] .badge,
    [data-sent] .rise {
      animation: none;
    }
    .check,
    [data-sent] .check {
      animation: none;
      stroke-dashoffset: 0;
    }
  }
</style>

<script>
  // Without JS the form still posts straight to Formspree; with JS it submits in place.
  const wrapper = document.getElementById("contact-panels") as HTMLElement;
  const form = document.getElementById("contact-form") as HTMLFormElement;
  const error = document.getElementById("contact-error") as HTMLElement;
  const submit = form.querySelector("button[type=submit]") as HTMLButtonElement;
  const title = document.getElementById("contact-success-title") as HTMLElement;
  const email = document.getElementById("contact-success-email") as HTMLElement;
  const message = document.getElementById("contact-success-message") as HTMLElement;

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    error.hidden = true;
    submit.disabled = true;

    const data = new FormData(form);
    try {
      const res = await fetch(form.action, {
        method: "POST",
        body: data,
        headers: { Accept: "application/json" },
      });
      if (!res.ok) throw new Error(res.statusText);

      const firstName = String(data.get("name")).trim().split(/\s+/)[0];
      title.textContent = firstName ? `Thanks, ${firstName}!` : "Thanks!";
      email.textContent = String(data.get("email"));
      message.textContent = String(data.get("message")).trim();
      form.reset();
      wrapper.dataset.sent = "";
      title.focus();
    } catch {
      error.hidden = false;
    } finally {
      submit.disabled = false;
    }
  });

  document.getElementById("contact-reset")?.addEventListener("click", () => {
    delete wrapper.dataset.sent;
    form.querySelector("input")?.focus();
  });
</script>

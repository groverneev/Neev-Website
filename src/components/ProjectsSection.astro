---
import { Icon } from "astro-icon/components";
import { projects } from "../data";
---

<section id="projects" class="scroll-mt-20 px-8">
  <div class="mx-auto max-w-[800px]">
    <p class="section-label mb-5">Projects</p>

    <div class="grid gap-4 min-[541px]:grid-cols-2">
      {
        projects.map((project) => (
          <a
            href={project.href}
            target="_blank"
            rel="noopener noreferrer"
            class="card h-full p-7 hover:-translate-y-0.5"
          >
            <Icon name={project.icon} size={15} class="mb-3 text-dim" />
            <h3 class="mb-2 text-lg font-semibold tracking-[-0.01em]">{project.title}</h3>
            <p class="mb-4 text-[15px] leading-[1.65] text-muted">{project.description}</p>
            <span class="inline-flex items-center gap-1 text-sm font-medium text-accent">
              Visit
              <svg class="size-[13px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14"></path>
                <path d="m12 5 7 7-7 7"></path>
              </svg>
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>

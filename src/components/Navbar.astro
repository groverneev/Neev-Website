---
import { navLinks } from "../data";

const external = { target: "_blank", rel: "noopener noreferrer" };
---

<nav
  class="sticky top-0 z-50 w-full border-b border-black/5 bg-bg/55 backdrop-blur-md"
>
  <div class="mx-auto max-w-[860px] px-8">
    <div class="flex h-[76px] items-center justify-between">
      <a href="/" class="text-[17px] font-bold tracking-[-0.025em] text-fg">Neev Grover</a>

      <ul class="hidden items-center gap-6 sm:flex">
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                {...(link.external ? external : {})}
                class="font-medium text-muted transition-colors hover:text-fg"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>

      <button
        id="menu-toggle"
        type="button"
        aria-label="Toggle menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="group flex cursor-pointer items-center justify-center rounded-md p-1.5 text-muted sm:hidden"
      >
        <svg class="size-5 group-aria-expanded:hidden" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" viewBox="0 0 24 24">
          <path d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <svg class="hidden size-5 group-aria-expanded:block" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" viewBox="0 0 24 24">
          <path d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <div id="mobile-menu" hidden class="border-t border-black/[0.07] py-3 sm:hidden">
      <div class="flex flex-col gap-0.5">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              {...(link.external ? external : {})}
              class="rounded-md px-1.5 py-2 text-[15px] font-medium text-muted transition-colors hover:text-fg"
            >
              {link.label}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</nav>

<script>
  const toggle = document.getElementById("menu-toggle") as HTMLElement;
  const menu = document.getElementById("mobile-menu") as HTMLElement;

  const setOpen = (open: boolean) => {
    menu.hidden = !open;
    toggle.setAttribute("aria-expanded", String(open));
  };

  toggle.addEventListener("click", () => setOpen(toggle.getAttribute("aria-expanded") !== "true"));
  menu.addEventListener("click", (e) => {
    if ((e.target as HTMLElement).closest("a")) setOpen(false);
  });
</script>
